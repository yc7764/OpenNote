# =============================================================================
# OpenNote 운영 compose(.env) 예시
#
# - docker-compose.yml의 backend·sttedit·frontend가 이 파일 하나를 공유한다.
#   `cp .env.example .env` 후 값을 채워서 사용한다. 값이 없으면 기동이 실패한다.
# - [필수] 표시가 없는 항목은 기본값이 있거나 기능 사용 시에만 필요하다.
# - Celery 워커(STT·요약)는 별도 장비에서 celery_workers/ 쪽 env로 구동한다.
#   (LLM API 키·HuggingFace 토큰 등 워커 전용 값은 이 파일에 넣지 않는다)
# =============================================================================

# -----------------------------------------------------------------------------
# Django — 설정 모듈
# -----------------------------------------------------------------------------
# [필수·보안] 운영은 반드시 production 모듈을 지정한다.
# 이미지 기본값은 base라서 이 값 없이 기동하면 쿠키 Secure·HSTS·SSL 리다이렉트·
# LocMemCache 기동 가드가 전부 빠진 비보안 상태로 뜬다.
DJANGO_SETTINGS_MODULE=config.settings.production

# [필수] Django 시크릿. `python -c "import secrets; print(secrets.token_urlsafe(64))"` 등으로 생성
SECRET_KEY=

# [필수] JWT 서명 키 — Django(SimpleJWT)와 sttEdit이 같은 값을 공유해야 한다.
# 다르면 sttEdit 소켓 인증이 전부 실패한다. SECRET_KEY와는 별도 값 권장
JWT_SECRET=

DEBUG=False

# 콤마 구분. 예: opennote.example.com,api.opennote.example.com
ALLOWED_HOSTS=

# 서비스 URL (이메일 링크·OAuth 콜백 조립에 사용)
SITE_URL=https://your-domain.example.com
SITE_NAME=OpenNote
NEXT_PUBLIC_FRONTEND_URL=https://your-domain.example.com

# CORS/CSRF — 콤마 구분 오리진 목록
CORS_ALLOWED_ORIGINS=https://your-domain.example.com
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — Django
# -----------------------------------------------------------------------------
# [필수]
DB_HOST=
DB_PORT=5432
DB_NAME=opennote
DB_USER=opennote
DB_PASSWORD=

# TLS로 DB에 붙는 경우. verify-ca/verify-full이면 DB_SSL_ROOT_CERT 필수(없으면 기동 실패)
#DB_SSL_MODE=verify-full
#DB_SSL_ROOT_CERT=/app/certs/ca.crt

# -----------------------------------------------------------------------------
# Cache / Celery — Django
# -----------------------------------------------------------------------------
# [필수·보안] 운영은 redis 고정 — locmem이면 워커 간 레이트리밋이 무력화돼 기동 가드가 막는다
CACHE_BACKEND=redis
# REDIS_PASSWORD 설정 시 URL에도 포함해야 한다: redis://:password@redis-cache:6379/1
REDIS_URL=redis://redis-cache:6379/1
# redis-cache requirepass — 설정하면 강제, 비우면 무인증(내부망 한정). sttEdit도 이 값을 읽는다
REDIS_PASSWORD=

# [필수] Celery 브로커·결과 백엔드
# amqps://(TLS)를 쓰면 CELERY_BROKER_CA_CERT 필수(없으면 기동 실패)
CELERY_BROKER_URL=amqp://user:password@rabbitmq-host:5672//
CELERY_RESULT_BACKEND=redis://redis-cache:6379/0
#CELERY_BROKER_CA_CERT=/app/certs/ca.crt

# -----------------------------------------------------------------------------
# Storage — Django (음성 파일)
# -----------------------------------------------------------------------------
# True면 S3/MinIO, False면 로컬 media/ 볼륨
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=opennote
AWS_S3_ENDPOINT_URL=https://minio.example.com:9000
#AWS_S3_USE_SSL=True
#AWS_S3_VERIFY=/app/certs/ca.crt
#AWS_S3_CUSTOM_DOMAIN=

# -----------------------------------------------------------------------------
# Email (SMTP) — 회원가입 인증·비밀번호 재설정 메일
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OpenNote <noreply@example.com>

# -----------------------------------------------------------------------------
# OAuth (소셜 로그인) — 사용할 프로바이더만 채우면 된다
# -----------------------------------------------------------------------------
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example.com/auth/callback/google

SOCIAL_AUTH_KAKAO_KEY=
SOCIAL_AUTH_KAKAO_SECRET=
KAKAO_CALLBACK_URL=https://your-domain.example.com/auth/callback/kakao

SOCIAL_AUTH_NAVER_KEY=
SOCIAL_AUTH_NAVER_SECRET=
NAVER_CALLBACK_URL=https://your-domain.example.com/auth/callback/naver

SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=
GITHUB_CALLBACK_URL=https://your-domain.example.com/auth/callback/github

# GitHub는 로그인용과 계정연동용 OAuth 앱이 분리돼 있다 (연동 기능 사용 시)
SOCIAL_AUTH_GITHUB_CONNECT_KEY=
SOCIAL_AUTH_GITHUB_CONNECT_SECRET=

# -----------------------------------------------------------------------------
# sttEdit (NestJS) — 같은 PostgreSQL을 바라본다
# -----------------------------------------------------------------------------
# [필수]
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USERNAME=opennote
POSTGRES_PASSWORD=
POSTGRES_DATABASE=opennote

# [필수] 콤마 구분 허용 오리진 (프론트 주소)
ALLOWED_ORIGINS=https://your-domain.example.com

NODE_ENV=production
PORT=21123

# Redis (Pub/Sub·세션) — STANDALONE 또는 CLUSTER
REDIS_MODE=STANDALONE
REDIS_HOST=redis-cache:6379
#REDIS_PASSWORD=
#REDIS_CLUSTER_NODES=
#REDIS_EXTERNAL_HOST=

# DB TLS (Django 쪽 DB_SSL_MODE와 짝 맞춤)
#DB_SSL=true
#DB_SSL_REJECT_UNAUTHORIZED=true
#DB_SSL_CA=/app/certs/ca.crt
#DB_POOL_SIZE=10

# Prometheus 메트릭 노출 (선택)
#METRICS_ENABLED=true
#METRICS_ALLOWED_IPS=10.0.0.0/8

# -----------------------------------------------------------------------------
# Frontend (Next.js) — 런타임 주입(NEXT_PUBLIC_*은 __ENV.js로 브라우저 전달)
# -----------------------------------------------------------------------------
# [필수] 셋 다 없으면 프론트가 API·소켓에 붙지 못한다
NEXT_PUBLIC_API_URL=https://your-domain.example.com
NEXT_PUBLIC_STT_EDIT_MODULE_URL=https://your-domain.example.com/sttedit
# NEXT_PUBLIC_FRONTEND_URL은 Django 섹션에서 정의됨 (공유)

# 미들웨어 CSP connect-src용 서버 전용 값(런타임) — API가 별도 오리진이면 반드시 지정.
# NEXT_PUBLIC_*는 빌드 시 placeholder로 구워져 미들웨어(서버)에서 못 읽으므로 이 값이 필요하다.
API_ORIGIN=https://your-domain.example.com

# sttEdit 소켓이 프론트와 다른 오리진일 때만 지정(CSP connect-src에 ws(s)로 추가).
# 게이트웨이가 same-origin(/socket.io/)으로 프록시하면 'self'가 커버하므로 비워둬도 된다.
#STT_EDIT_ORIGIN=https://your-domain.example.com

# 소셜 로그인 버튼용 공개 클라이언트 ID (시크릿 아님 — 브라우저에 노출되는 값)
# 위 SOCIAL_AUTH_*_KEY와 같은 값을 쓰되, 사용하는 프로바이더만 채우면 된다
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CONNECT_CLIENT_ID=

# -----------------------------------------------------------------------------
# 선택 — 보안·레이트리밋 튜닝 (기본값은 settings/production.py가 처리)
# -----------------------------------------------------------------------------
#SESSION_COOKIE_SECURE=True
#CSRF_COOKIE_SECURE=True
#JWT_AUTH_SECURE=True
#SECURE_HSTS_SECONDS=31536000
#LOGIN_ATTEMPT_LIMIT=5
#LOGIN_LOCKOUT_DURATION=300

# -----------------------------------------------------------------------------
# 선택 — 컨테이너 메모리 상한 (서버 스펙에 맞게 조정, 미설정 시 compose 기본값)
# -----------------------------------------------------------------------------
#BACKEND_MEM_LIMIT=1g
#STTEDIT_MEM_LIMIT=1g
#FRONTEND_MEM_LIMIT=1g
#REDIS_MEM_LIMIT=128m
#PROMTAIL_MEM_LIMIT=128m

# -----------------------------------------------------------------------------
# 선택 — 호스트 포트 바인딩 주소 (기본: 127.0.0.1 = 외부 미노출)
# -----------------------------------------------------------------------------
# [보안] Docker의 DNAT는 호스트 방화벽(DOCKER-USER)보다 앞단에서 동작하므로,
# 0.0.0.0으로 발행하면 방화벽 규칙을 우회해 인터넷에 직접 노출된다.
# 게이트웨이(nginx)가 같은 호스트면 기본값(127.0.0.1) 그대로 둘 것.
# 게이트웨이가 다른 호스트라면 아래를 0.0.0.0으로 열되, 반드시 호스트 방화벽에서
# 게이트웨이 IP만 허용하고 나머지는 DROP 해야 한다.
#BACKEND_BIND=0.0.0.0
#STTEDIT_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# 선택 — Prometheus /metrics 접근 제어
# -----------------------------------------------------------------------------
# 쉼표 구분 IP 또는 CIDR. Django·sttEdit이 같은 키를 쓴다.
# 프록시 헤더가 아니라 TCP 접속원(REMOTE_ADDR)을 보므로, 스크레이퍼가 nginx나
# 도커 브리지를 거쳐 들어오면 그 홉의 IP를 넣어야 한다(예: 172.16.0.0/12).
#METRICS_ALLOWED_IPS=127.0.0.1,::1
# false로 두면 /metrics를 404로 감춘다
#METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# 참고 — Celery 워커 전용 키 (이 compose에서는 사용하지 않음)
# -----------------------------------------------------------------------------
# STT·요약 워커는 별도 장비의 celery_workers/ compose로 구동하며, 그쪽 env에
# 다음 키가 필요하다: GROQ_API_KEY, GOOGLE_API_KEY, MISTRAL_API_KEY,
# HUGGINGFACE_TOKEN, WHISPER_MODEL_SIZE/DEVICE/COMPUTE_TYPE, GPU_MEMORY_FRACTION,
# STT/SUMMARY_WORKER_CONCURRENCY 등. LLM·HF 토큰을 이 파일에 넣지 말 것 —
# 웹 3서비스 프로세스에 워커 시크릿까지 노출된다.
