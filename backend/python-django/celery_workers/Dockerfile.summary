# celery_workers/Dockerfile.summary
# Summary Worker - CPU 이미지 (~500MB)
# Ubuntu 22.04 + uv sync 기반 초고속 빌드

FROM ubuntu:22.04 AS base

WORKDIR /app

# 시스템 패키지 및 타임존 설정
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tzdata \
    # uv sync는 extra를 하나만 설치해도 전체 의존성 그래프를 해결한다.
    # web extra의 dj-rest-auth가 git URL이라 해결 단계에서 git이 필요하다.
    git \
 && ln -snf /usr/share/zoneinfo/Asia/Seoul /etc/localtime \
 && echo "Asia/Seoul" > /etc/timezone \
 && dpkg-reconfigure -f noninteractive tzdata \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# uv 설치 — 핀 고정된 공식 이미지에서 바이너리 복사(체크섬 검증된 재현 빌드).
# 이전엔 `curl ... install.sh | sh`라 스크립트 무결성 검증 없이 root 임의 코드 실행 경로였다.
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /usr/local/bin/

# uv가 설치하는 Python을 공용 경로에 둔다 — 기본값(/root/.local)은 비-root
# 사용자가 접근할 수 없어 venv 인터프리터 로드가 실패한다(No module named 'encodings').
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python

# Python 3.10 설치
RUN uv python install 3.10

# 의존성 파일 먼저 복사 (레이어 캐싱 최적화)
# pyproject.summary.toml 변경 시에만 이 레이어 재빌드
# 의존성은 backend/python-django/pyproject.toml 한 곳에서 관리한다 (extra로 분리).
# 기존 celery_workers/uv.lock은 분리 시절의 것이라 더 이상 사용하지 않는다.
COPY pyproject.toml uv.lock ./

# uv sync로 초고속 의존성 설치 (lockfile 고정, 해결 단계 생략)
# --frozen: uv.lock을 그대로 설치, 재해석 없음 (재현 가능한 빌드)
# --no-install-project: 의존성만 설치, 프로젝트 자체는 빌드하지 않음
RUN uv sync --frozen --python 3.10 --no-install-project --extra summary

# 애플리케이션 코드 복사 (코드 변경 시에만 이 레이어부터 재빌드)
COPY . .
RUN mkdir -p /app/logs

# 보안: 비-root 사용자로 실행
# 호스트 logs/ 바인드마운트 소유자(uid 1000)와 맞춰 uid 1000 고정
RUN groupadd -g 1000 appuser \
 && useradd -u 1000 -g 1000 -m -s /bin/bash appuser \
 && chown -R appuser:appuser /app /opt/uv-python
USER appuser

ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings.worker
ENV WORKER_TYPE=summary_worker
ENV PATH="/app/.venv/bin:${PATH}"

CMD ["celery", "-A", "celery_workers.summary_worker", "worker", \
     "-Q", "summary_queue", "-c", "4", "--loglevel=info", \
     "--hostname=summary_worker@%h"]
